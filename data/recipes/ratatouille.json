		{"id": "slice_zucchini", "text": "Нарезать кабачок", "requires": []},
		{"id": "slice_tomato", "text": "Нарезать помидоры", "requires": []},
		{"id": "slice_pepper", "text": "Нарезать болгарский перец", "requires": []},
		{"id": "slice_onion", "text": "Нарезать лук и чеснок", "requires": []},
		{"id": "heat_oil", "text": "Разогреть оливковое масло", "requires": []},
